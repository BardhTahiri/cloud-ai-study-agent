# Application
APP_NAME=cloud-ai-study-agent
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173

# Database - local non-Docker default
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/cloud_ai_study_agent

# PostgreSQL - used by docker-compose and local backend if copied to .env
POSTGRES_DB=cloud_ai_study_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345678

# To run backend locally against PostgreSQL, use:
# DATABASE_URL=postgresql://postgres:12345678@localhost:5432/cloud_ai_study_agent

# Queue
REDIS_URL=redis://localhost:6379/0

# AI Provider
OPENAI_API_KEY=replace_me

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads
