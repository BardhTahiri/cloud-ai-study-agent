# Application
APP_NAME=cloud-ai-study-agent
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173

# Database - local non-Docker default
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/cloud_ai_study_agent

# PostgreSQL - used by docker-compose and local backend if copied to .env
POSTGRES_DB=cloud_ai_study_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345678

# To run backend locally against PostgreSQL, use:
# DATABASE_URL=postgresql://postgres:12345678@localhost:5432/cloud_ai_study_agent

# Local backend -> cloud agent
TASK_QUEUE_MODE=local
TASK_QUEUE_FALLBACK_LOCAL=true
AGENT_BASE_URL=http://localhost:8010
AGENT_API_KEY=change-this-before-cloud-deployment
AGENT_HTTP_TIMEOUT_SECONDS=15

# Cloud agent queue and temporary result storage
REDIS_URL=redis://localhost:6379/0
AGENT_RESULT_EXPIRES_SECONDS=604800

# AI agent URL switch
# Empty URL: offline deterministic generator
# OpenAI URL: paid OpenAI agent
# Any other OpenAI-compatible URL: free/local model agent
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=
FREE_LLM_MODEL=qwen3:8b
PAID_LLM_MODEL=gpt-5.6-sol
LLM_FALLBACK_TO_OFFLINE=true
LLM_TIMEOUT_SECONDS=120
LLM_MAX_INPUT_CHARS=100000

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads
